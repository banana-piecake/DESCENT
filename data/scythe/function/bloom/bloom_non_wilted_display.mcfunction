execute if score @s descent_bloom_amount matches 0..80 run title @s actionbar "Budding"
execute if score @s descent_bloom_amount matches 81..140 run title @s actionbar "Growing"
execute if score @s descent_bloom_amount matches 141..180 run title @s actionbar "Flourishing"
execute if score @s descent_bloom_amount matches 181..220 run title @s actionbar "Drooping"